<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Self-hosted deployments may run on local LAN or dev HTTP endpoints.
         The app explicitly warns users whenever connecting over non-HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
